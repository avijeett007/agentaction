# AgentAction server
NODE_ENV=development
PORT=4890
# The URL phones dial back on; it is put into the pairing QR code, so it must be
# reachable from a mobile network, not just from this machine.
PUBLIC_BASE_URL=http://localhost:4890
# SQLite locally, Postgres in production (see npm run db:postgres)
DATABASE_URL="file:./dev.db"
# Signs nothing by itself; each tenant has its own webhook secret in the database.
LOG_LEVEL=info
# Expo push. Sending is ON by default — a deployment that notifies nobody is the
# one failure this product cannot afford. The access token is optional at Expo
# (it buys enhanced security, not the ability to send).
EXPO_ACCESS_TOKEN=
# Set true to silence push entirely. Local development and the test suite do.
EXPO_PUSH_DISABLED=false
# Seconds a pairing code stays valid.
PAIRING_TTL_SEC=300
# Allowed clock skew on device-signed requests, in seconds.
SIGNATURE_SKEW_SEC=120
