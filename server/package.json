{
  "name": "@agentaction/server",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch --runInBand",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:postgres": "node scripts/to-postgres.js",
    "db:deploy": "prisma db push --schema=prisma/schema.postgres.prisma --skip-generate"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "expo-server-sdk": "^3.10.0",
    "express": "^4.21.2",
    "prisma": "^6.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "license": "Apache-2.0",
  "author": "Kno2gether Labs LTD",
  "repository": {
    "type": "git",
    "url": "https://github.com/avijeett007/agentaction.git"
  }
}
