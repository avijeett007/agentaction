{
  "expo": {
    "name": "AgentAction",
    "slug": "agentaction",
    "scheme": "agentaction",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pro.knotie.agentaction",
      "infoPlist": {
        "NSCameraUsageDescription": "AgentAction uses the camera only to scan the pairing QR code shown in your portal.",
        "NSFaceIDUsageDescription": "AgentAction asks for Face ID so only you can approve an agent's action.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "backgroundColor": "#0A0E1A"
    },
    "android": {
      "package": "pro.knotie.agentaction",
      "permissions": [
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0A0E1A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "backgroundColor": "#0A0E1A",
      "googleServicesFile": "./google-services.json",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "AgentAction uses the camera only to scan the pairing QR code shown in your portal.",
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "AgentAction asks for Face ID so only you can approve an agent's action."
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      "expo-asset"
    ],
    "backgroundColor": "#0A0E1A"
  }
}